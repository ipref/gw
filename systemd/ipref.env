# IPREF Gateway Configuration
# Edit this file to customize your deployment
# Location: /etc/sysconfig/ipref

# ==============================================================================
# GATEWAY CONFIGURATION
# ==============================================================================

# Bind IP address for gateway (which interface to listen on)
# Use 0.0.0.0 to listen on all interfaces
GATEWAY_BIND_IP=0.0.0.0

# Public IP address of the gateway
# - For client-only mode: Use 0.0.0.0
# - For server mode: Use your actual public IP (e.g., 203.0.113.5)
# - If behind NAT: Use the external NAT IP address
GATEWAY_PUBLIC_IP=0.0.0.0

# Encoded network range
# This is the virtual address space used to represent remote IPREF hosts
# Default: 10.240.0.0/12 (10.240.0.0 - 10.255.255.255)
# Must not conflict with your internal network
ENCODE_NETWORK=10.240.0.0/12

# ==============================================================================
# DNS AGENT CONFIGURATION
# ==============================================================================

# IP version for encoded addresses (local network)
# Use 4 for IPv4, 6 for IPv6
EA_IPVER=4

# IP version for gateway-to-gateway tunnel
# Use 4 for IPv4, 6 for IPv6
GW_IPVER=4

# DNS update interval in minutes
# How often to query DNS servers for updates
DNS_UPDATE_INTERVAL=60

# DNS zone configuration
# Format: internal_tld:external_domain:nameserver1,nameserver2
#
# Examples:
#   Client mode (no publishing):
#     DNS_ZONE_CONFIG=""
#
#   Server mode (publishing services):
#     DNS_ZONE_CONFIG="internal:example.com:ns1.example.com,ns2.example.com"
#
#   Multiple zones:
#     DNS_ZONE_CONFIG="internal:example.com:ns1.example.com,ns2.example.com dmz:example.net:ns1.example.net"
DNS_ZONE_CONFIG=""
